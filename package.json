{
  "name": "darukaa-earth",
  "version": "1.0.0",
  "description": "Darukaa.Earth — Geospatial Carbon & Biodiversity Project Intelligence Platform",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint:frontend": "npm --prefix frontend run lint",
    "test:frontend": "npm --prefix frontend run test",
    "build:frontend": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx}": "npm --prefix frontend run lint --",
    "backend/**/*.py": ["python -m ruff check --fix", "python -m ruff format"]
  }
}
