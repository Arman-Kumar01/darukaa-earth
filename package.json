{
  "name": "darukaa-earth",
  "version": "1.0.0",
  "description": "Darukaa.Earth — Geospatial Carbon & Biodiversity Project Intelligence Platform",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint:frontend": "cd frontend && npm run lint",
    "test:frontend": "cd frontend && npm run test",
    "test:backend": "cd backend && python -m pytest tests/ -v",
    "build:frontend": "cd frontend && npm run build"
  },
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx,js,jsx}": [
      "cd frontend && npx eslint --fix",
      "cd frontend && npx prettier --write"
    ],
    "frontend/src/**/*.{css,json,md}": [
      "cd frontend && npx prettier --write"
    ],
    "backend/**/*.py": [
      "ruff check --fix",
      "ruff format"
    ]
  }
}
