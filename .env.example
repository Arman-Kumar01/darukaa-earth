# =============================================================
# Darukaa.Earth — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# =============================================================

# --- Database ---
# Full PostgreSQL connection string with PostGIS-enabled database
DATABASE_URL=postgresql://postgres:password@localhost:5432/darukaa_earth

# --- JWT Authentication ---
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-very-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Mapbox (Frontend) ---
# Get your token at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# --- Application URLs ---
VITE_API_BASE_URL=http://localhost:8000

# --- Demo Credentials (populated by seed script) ---
# These are set by seed.py — change passwords in production
DEMO_ADMIN_EMAIL=admin@darukaa.earth
DEMO_ADMIN_PASSWORD=DemoAdmin2024!
DEMO_USER_EMAIL=user@darukaa.earth
DEMO_USER_PASSWORD=DemoUser2024!

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Environment ---
ENVIRONMENT=development
